ELASTIC_PASSWORD=changeme
KIBANA_PASSWORD=changeme
FLEET_TOKEN=
STACK_VERSION=8.14.3
LAB_NETWORK=172.30.0.0/24
# Where Elasticsearch (9200) and Fleet (8220) are published on the host. The
# installer sets this: 127.0.0.1 normally, or the host-only/NAT adapter address
# (e.g. 192.168.56.1) when the optional Windows VM must reach them. Do not set it
# to 0.0.0.0 - that puts the SIEM on your local network. Kibana and the
# deliberately vulnerable web apps are always bound to 127.0.0.1.
LAB_BIND_IP=127.0.0.1
# LAB_PROVIDER=vmware_desktop   # uncomment to use VMware Workstation
